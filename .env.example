# ------------------------------------------------------------------------------
# M-PESA Statement Parser Environment Configuration
# ------------------------------------------------------------------------------
# Copy this file to '.env' and fill in your actual statement details:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ------------------------------------------------------------------------------

# Path to your Safaricom M-PESA PDF statement
MPESA_PDF=MPESA_Statement.pdf

# PDF Password (typically your National ID or Passport Number)
# Leave empty if the PDF is not password-protected
MPESA_PASSWORD=your_id_number_or_password_here
